# Google Photorealistic 3D Tiles credentials for local development.
# Copy this file to .env.local and fill one in; `pnpm dev` will load it.
#
# A free Cesium Ion account gives you a token that unlocks asset 2275207:
#   https://ion.cesium.com/tokens
VITE_ION_TOKEN=

# Or a Google Maps Platform key with the Map Tiles API enabled:
#   https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_API_KEY=

# `pnpm build` deliberately ignores these values. To bake a referrer-restricted
# key into a public bundle on purpose, use `pnpm build:with-credentials`.
